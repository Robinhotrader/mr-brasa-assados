{
  "expo": {
    "name": "MR Brasa Assados",
    "slug": "mr-brasa-assados",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "platforms": ["ios", "android", "web"],
    "jsEngine": "jsc",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "mrbrasa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrbrasa.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FF6B35"
      },
      "package": "com.mrbrasa.app"
    },
    "extra": {
      "eas": {
        "projectId": "dc75ce6f-3919-4096-b1e2-bfefe1e729d1"
      }
    }
  }
}
