      "favicon": "./assets/favicon.png"
    },
    "scheme": "mrbrasa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrbrasa.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "package": "com.mrbrasa.app"
    },
    "extra": {
      "eas": {
        "projectId": "dc75ce6f-3919-4096-b1e2-bfefe1e729d1"
      }
    }
  }
}
